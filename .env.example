# Kopiere diese Datei zu ".env" und trage ein, was du nutzen willst.
# Es reicht EIN Anbieter. In der App wählst du ihn unter Einstellungen → KI-Server.

# --- Claude (Anthropic) – kostenpflichtig, sehr gute Qualität ---
# Key: https://console.anthropic.com → API Keys
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5        # günstiger: claude-haiku-5-5

# --- Gemini (Google) – Gratis-Kontingent möglich ---
# Key: https://aistudio.google.com → Get API key
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-flash-latest

# --- Ollama (lokal auf dem Mac) – kostenlos, kein Key nötig ---
# Ollama-App starten und ein Modell laden, z. B.:  ollama pull gemma3
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3

# Optional, empfohlen bei öffentlicher URL: Passwort für die KI-Funktionen.
# Dasselbe Passwort in der App unter Einstellungen → KI-Server eintragen.
# APP_SECRET=ein-langes-passwort
