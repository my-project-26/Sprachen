# Kopiere diese Datei zu ".env" und trage deinen Schlüssel ein.
# Schlüssel erstellen: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: anderes Modell (Standard: claude-sonnet-5-5, günstiger: claude-haiku-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional, aber empfohlen bei öffentlicher URL: Passwort für die KI-Funktionen.
# Dasselbe Passwort in der App unter Einstellungen → KI-Server eintragen.
# APP_SECRET=ein-langes-passwort
